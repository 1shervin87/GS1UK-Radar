# ---- LLM (required for live runs) -------------------------------------------
# Choose one provider. Anthropic is the default.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
#
# Free option (no card needed): Google Gemini via its OpenAI-compatible endpoint.
# Get a key at https://aistudio.google.com -> "Get API key", then:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=<your Gemini key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash
# LLM_MAX_ITEMS_TO_ANALYSE=15     # keep within the free tier's daily request limit

# ---- Web search --------------------------------------------------------------
# Optional. With a Tavily key the agent gets dated news results and domain hints.
# Without it the pipeline falls back to DuckDuckGo (no key). GOV.UK and
# legislation.gov.uk connectors never need a key.
TAVILY_API_KEY=

# ---- Schedule (defaults: every Monday 08:00 Europe/London) -------------------
SCHEDULE_ENABLED=true
SCHEDULE_TIMEZONE=Europe/London
SCHEDULE_DAY_OF_WEEK=mon
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
LOOKBACK_DAYS=7
RUN_ON_STARTUP=false

# ---- Analysis tuning ---------------------------------------------------------
LLM_MAX_ITEMS_TO_ANALYSE=40
RELEVANCE_THRESHOLD=55
MAX_RESULTS_PER_QUERY=8

# ---- Security / infra --------------------------------------------------------
# Bearer token required by POST /api/admin/run ("Run now" button). Leave empty to disable.
ADMIN_TOKEN=change-me
DATABASE_URL=sqlite:///./data/radar.db
ENVIRONMENT=production
